# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Or use deploy.html. Never commit your real .env.
BOOTSTRAP_KEY=
SITE_NAME=moyami

# Your own HTTPS app origin; Vercel's generated production URL is used automatically.
# Set this when adding a custom domain, then rebuild connector packages.
APP_URL=
# CONNECTOR_READER_ORIGINS=https://reader.example.com,https://second.example.com

# Vercel: connect Upstash Redis through Storage/Marketplace; these are auto-injected.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.
# Use a dedicated database. If sharing intentionally, give each app a stable distinct namespace.
# AUTH_NAMESPACE=moyami
# BROKER_STORE=redis

# Local/Docker only (account file must be on persistent storage):
MOYAMI_PORT=4173
COOKIE_SECURE=0
# AUTH_FILE=data/auth.json
# Set COOKIE_SECURE=1 behind HTTPS.
# Optional server-side HTTP/SOCKS proxy; never expose credentials to the browser.
SOURCE_OUTBOUND_PROXY=
