{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "server/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "probes/**/*.ts",
    "api/**/*.ts"
  ]
}
