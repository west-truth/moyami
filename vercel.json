{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:hosting",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "regions": ["icn1"],
  "functions": { "api/index.ts": { "maxDuration": 120, "supportsCancellation": true } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "same-origin" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/runtime/(.*)", "headers": [{ "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'" }] }
  ]
}
